#!/bin/sh
# Pre-commit hook del repo. Corre en orden el formatter, el linter y la suite
# de tests con el umbral de cobertura de la DoD. Si un paso falla, el commit
# se aborta y los cambios quedan en el área de trabajo.
# Se activa una vez por clon con: git config core.hooksPath hooks

BIN=.venv/bin

paso() {
    titulo=$1
    shift
    echo "==> $titulo"
    if ! "$@"; then
        echo ""
        echo "pre-commit: falló el paso \"$titulo\". Commit abortado."
        exit 1
    fi
}

paso "1/3 Formatter: black" "$BIN/black" --check .
paso "2/3 Linter: ruff" "$BIN/ruff" check .
paso "3/3 Tests y cobertura: pytest" "$BIN/pytest" -q -p no:cacheprovider \
    --cov --cov-report=term-missing:skip-covered --cov-fail-under=80
echo "pre-commit: formatter, linter y tests en verde."
